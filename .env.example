# =============================================================================
# Vertex Dental Lab (London, UK) — Environment Configuration Template
# Clean Architecture: Next.js (App Router in src/) + Supabase PostgreSQL (eu-west-2) + pg_cron
# =============================================================================

# ── 1. App Environment & Hosting ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 2. Supabase PostgreSQL (eu-west-2 London) ──────────────────────────────────
# Single Source of Truth for Appointments, Patients, and Chat Logs
# Ensure your Supabase project region is set to London (eu-west-2) for UK GDPR
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Shared secret for Edge Function and pg_cron webhooks
CRON_SECRET=your-random-cron-secret-32-chars

# ── 3. AI Engines (UK Dental Clinical Concierge & Chatbot) ────────────────────
# Powers tool calling for check_available_slots and book_appointment with UK fee grounding
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 4. Google Sheets API (Real-Time Booking Sync v4) ──────────────────────────
# Google Spreadsheet ID (from docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SHEETS_CLIENT_EMAIL=sheets-sync@vertex-dental.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_RANGE=Sheet1!A:H

# Optional raw Service Account JSON format:
# GOOGLE_SHEETS_SA_KEY={"type":"service_account","project_id":"vertex-dental",...}

# ── 5. Twilio (Exact 1-Hour Before Patient SMS Reminders) ──────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=VertexDent
TWILIO_PHONE_NUMBER=+447xxxxxxxxxx
TWILIO_SENDER_ID=VertexDent

# ── 6. Resend / SMTP (08:00 AM London Daily Owner Email Digest + CSV) ─────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CLINIC_OWNER_EMAIL=owner@vertexdental.co.uk
EMAIL_FROM=Vertex Dental Lab <reports@vertexdental.co.uk>

# ── 7. Clinic Operational Details ─────────────────────────────────────────────
CLINIC_NAME="Vertex Dental Lab"
CLINIC_ADDRESS="45 Harley Street, London, W1G 8QR"
CLINIC_PHONE="+447946088800"
CLINIC_TIMEZONE="Europe/London"
CLINIC_HOURS="09:00 - 17:00 (Mon - Fri)"
