{
  "name": "dental-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run build:widget",
    "build:widget": "esbuild widget/src/widget.ts --bundle --minify --outfile=dist/widget.js --format=iife --global-name=DentalWidget",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/tasks": "^5.5.0",
    "@google/generative-ai": "^0.21.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "fastify": "^4.28.1",
    "google-auth-library": "^9.14.1",
    "googleapis": "^144.0.0",
    "libphonenumber-js": "^1.11.4",
    "next-auth": "^4.24.7",
    "pino": "^9.4.0",
    "pino-pretty": "^11.3.0",
    "resend": "^3.5.0",
    "stripe": "^16.12.0",
    "twilio": "^5.3.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.16.10",
    "esbuild": "^0.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
